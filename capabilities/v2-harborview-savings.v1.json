{
  "name": "v2-harborview-savings",
  "version": "1.0.0",
  "app": {
    "id": "vendor-console",
    "startPath": "/search"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "sensitive": false
    },
    "username": {
      "type": "string",
      "sensitive": true
    },
    "password": {
      "type": "string",
      "sensitive": true
    }
  },
  "outputs": {
    "balance": {
      "type": "money",
      "sensitive": true
    }
  },
  "businessOutcomes": {},
  "steps": [
    {
      "id": "s1",
      "intent": "Navigate to /search",
      "action": {
        "verb": "navigate",
        "value": "/search"
      },
      "target": {
        "properties": {
          "role": "navigation",
          "frame": "main"
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Sign In"
      }
    },
    {
      "id": "s2",
      "intent": "Enter the provided <username> username",
      "action": {
        "verb": "type",
        "value": {
          "$input": "username"
        }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f1",
          "neighborText": [
            "Username"
          ],
          "position": {
            "x": 705,
            "y": 245
          },
          "size": {
            "w": 156,
            "h": 18
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s3",
      "intent": "Enter the provided <username> password",
      "action": {
        "verb": "type",
        "value": {
          "$input": "password"
        }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f2",
          "neighborText": [
            "Password"
          ],
          "position": {
            "x": 705,
            "y": 330
          },
          "size": {
            "w": 156,
            "h": 18
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s4",
      "intent": "Submit the login form with the provided credentials",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Sign In",
          "position": {
            "x": 660,
            "y": 417
          },
          "size": {
            "w": 65,
            "h": 23
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Home"
      }
    },
    {
      "id": "s5",
      "intent": "Open customer search to look up member <memberId>",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "link",
          "frame": "main",
          "name": "Customer Search",
          "position": {
            "x": 49,
            "y": 138
          },
          "size": {
            "w": 82,
            "h": 14
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Customer Search"
      }
    },
    {
      "id": "s6",
      "intent": "Enter the requested customer ID for the customer search.",
      "action": {
        "verb": "type",
        "value": {
          "$input": "memberId"
        }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f1",
          "neighborText": [
            "Customer",
            "ID"
          ],
          "position": {
            "x": 417,
            "y": 167
          },
          "size": {
            "w": 146,
            "h": 18
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s7",
      "intent": "Submit the customer search for member ID <memberId>.",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Customer Search",
          "position": {
            "x": 400,
            "y": 323
          },
          "size": {
            "w": 112,
            "h": 23
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Customer Search"
      }
    },
    {
      "id": "s8",
      "intent": "Read the savings account balance for customer <memberId> from the Balance column.",
      "action": {
        "verb": "read",
        "parseAs": "money",
        "saveTo": "balance"
      },
      "target": {
        "properties": {
          "role": "cell",
          "frame": "accounts",
          "name": "$4,320.10",
          "columnHeader": "Balance",
          "neighborText": [
            "00"
          ],
          "position": {
            "x": 574,
            "y": 34
          },
          "size": {
            "w": 167,
            "h": 22
          }
        },
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "outputPopulated": "balance"
      }
    }
  ]
}