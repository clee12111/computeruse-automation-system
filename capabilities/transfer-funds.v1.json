{
  "name": "transfer-funds",
  "version": "2.0.0",
  "app": {
    "id": "vendor-console",
    "startPath": "/search"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "sensitive": false
    },
    "fromAccount": {
      "type": "string",
      "sensitive": false
    },
    "toAccount": {
      "type": "string",
      "sensitive": false
    },
    "amount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
      "sensitive": false
    },
    "username": {
      "type": "string",
      "sensitive": true
    },
    "password": {
      "type": "string",
      "sensitive": true
    }
  },
  "outputs": {
    "referenceNumber": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{4,20}$",
      "sensitive": false
    }
  },
  "businessOutcomes": {
    "PERMISSION_DENIED": {
      "detect": {
        "textPresent": "Insufficient privileges"
      }
    },
    "INSUFFICIENT_FUNDS": {
      "detect": {
        "textPresent": "Insufficient funds"
      }
    }
  },
  "steps": [
    {
      "id": "s1",
      "intent": "Navigate to login",
      "action": {
        "verb": "navigate",
        "value": "/login"
      },
      "target": {
        "properties": { "role": "navigation", "frame": "main" },
        "reasoning": "Page-level navigation."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Sign In"
      }
    },
    {
      "id": "s2",
      "intent": "Enter username",
      "action": {
        "verb": "type",
        "value": { "$input": "username" }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f1",
          "neighborText": ["Username"],
          "position": { "x": 705, "y": 245 },
          "size": { "w": 156, "h": 18 }
        },
        "reasoning": "Login form username field."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s3",
      "intent": "Enter password",
      "action": {
        "verb": "type",
        "value": { "$input": "password" }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f2",
          "neighborText": ["Password"],
          "position": { "x": 705, "y": 330 },
          "size": { "w": 156, "h": 18 }
        },
        "reasoning": "Login form password field."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s4",
      "intent": "Click Sign In",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Sign In",
          "position": { "x": 660, "y": 417 },
          "size": { "w": 65, "h": 23 }
        },
        "reasoning": "Login submit button."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Dashboard"
      }
    },
    {
      "id": "s5",
      "intent": "Navigate to member search",
      "action": {
        "verb": "navigate",
        "value": "/search"
      },
      "target": {
        "properties": { "role": "navigation", "frame": "main" },
        "reasoning": "Navigate to search."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Member Number"
      }
    },
    {
      "id": "s6",
      "intent": "Enter member number",
      "action": {
        "verb": "type",
        "value": { "$input": "memberId" }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "attrName": "f1",
          "neighborText": ["Member", "Number"],
          "position": { "x": 417, "y": 167 },
          "size": { "w": 146, "h": 18 }
        },
        "reasoning": "Search form input."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s7",
      "intent": "Submit search",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Member Search",
          "position": { "x": 397, "y": 323 },
          "size": { "w": 106, "h": 23 }
        },
        "reasoning": "Search submit button."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Member Details"
      },
      "onCondition": [
        {
          "if": {
            "textPresent": "Compliance Notice"
          },
          "do": [
            {
              "verb": "click",
              "targetName": "checkbox:compliance"
            },
            {
              "verb": "click",
              "targetName": "Continue"
            }
          ],
          "maxApplies": 2
        }
      ]
    },
    {
      "id": "s8",
      "intent": "Click Transfer Funds link",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "link",
          "frame": "main",
          "name": "Transfer Funds"
        },
        "reasoning": "Transfer link on member detail page."
      },
      "risk": "safe",
      "expect": {
        "anyOf": [
          { "textPresent": "Transfer Funds" },
          { "$outcome": "PERMISSION_DENIED" }
        ]
      }
    },
    {
      "id": "s9",
      "intent": "Select from-account",
      "action": {
        "verb": "select",
        "value": { "$input": "fromAccount" }
      },
      "target": {
        "properties": {
          "role": "combobox",
          "frame": "main",
          "neighborText": ["From", "Account"]
        },
        "reasoning": "Source account dropdown."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s10",
      "intent": "Select to-account",
      "action": {
        "verb": "select",
        "value": { "$input": "toAccount" }
      },
      "target": {
        "properties": {
          "role": "combobox",
          "frame": "main",
          "neighborText": ["To", "Account"]
        },
        "reasoning": "Destination account dropdown."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s11",
      "intent": "Enter transfer amount",
      "action": {
        "verb": "type",
        "value": { "$input": "amount" }
      },
      "target": {
        "properties": {
          "role": "textbox",
          "frame": "main",
          "neighborText": ["Amount"]
        },
        "reasoning": "Transfer amount input."
      },
      "risk": "safe",
      "expect": {
        "elementValue": { "$self": true }
      }
    },
    {
      "id": "s12",
      "intent": "Submit for review",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Review Transfer"
        },
        "reasoning": "Review button."
      },
      "risk": "safe",
      "expect": {
        "anyOf": [
          { "textPresent": "Execute Transfer" },
          { "$outcome": "INSUFFICIENT_FUNDS" }
        ]
      }
    },
    {
      "id": "s13",
      "intent": "Execute the transfer",
      "action": {
        "verb": "click"
      },
      "target": {
        "properties": {
          "role": "button",
          "frame": "main",
          "name": "Execute Transfer"
        },
        "reasoning": "Confirm and execute the transfer."
      },
      "risk": "risky",
      "expect": {
        "textPresent": "Transfer Complete"
      }
    },
    {
      "id": "s14",
      "intent": "Read the transfer reference number",
      "action": {
        "verb": "read",
        "parseAs": "string",
        "saveTo": "referenceNumber"
      },
      "target": {
        "properties": {
          "role": "cell",
          "frame": "main",
          "neighborText": ["Reference"]
        },
        "reasoning": "Reference number cell in the row labeled 'Reference #'."
      },
      "risk": "safe",
      "expect": {
        "outputPopulated": "referenceNumber"
      }
    }
  ]
}
