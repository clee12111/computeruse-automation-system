{
  "name": "harborview-savings-balance",
  "version": "1.0.0",
  "app": {
    "id": "vendor-console",
    "startPath": "/search"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "pattern": "^[0-9]{5}$",
      "sensitive": false
    },
    "username": {
      "type": "string",
      "sensitive": true
    },
    "password": {
      "type": "string",
      "sensitive": true
    }
  },
  "outputs": {
    "balance": {
      "type": "money",
      "sensitive": true
    }
  },
  "businessOutcomes": {},
  "steps": [
    {
      "id": "s1",
      "intent": "Navigate to /search",
      "action": {
        "verb": "navigate",
        "value": "/search"
      },
      "target": {
        "chain": [
          {
            "by": "structural",
            "note": "navigation target"
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Sign In"
      }
    },
    {
      "id": "s2",
      "intent": "Enter the provided <username> username",
      "action": {
        "verb": "type",
        "value": {
          "$input": "username"
        }
      },
      "target": {
        "chain": [
          {
            "by": "labelProximity",
            "role": "textbox",
            "anchor": "Username"
          },
          {
            "by": "structural",
            "note": "textbox #1 of 2 in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 705,
            "y": 245
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s3",
      "intent": "Enter the provided password to complete the login form.",
      "action": {
        "verb": "type",
        "value": {
          "$input": "password"
        }
      },
      "target": {
        "chain": [
          {
            "by": "labelProximity",
            "role": "textbox",
            "anchor": "Password"
          },
          {
            "by": "structural",
            "note": "textbox #2 of 2 in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 705,
            "y": 330
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s4",
      "intent": "Submit the completed login form to access the <username> console.",
      "action": {
        "verb": "click"
      },
      "target": {
        "chain": [
          {
            "by": "roleName",
            "role": "button",
            "name": "Sign In"
          },
          {
            "by": "structural",
            "note": "only button in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 660,
            "y": 417
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Home"
      }
    },
    {
      "id": "s5",
      "intent": "Open customer search to look up member <memberId>.",
      "action": {
        "verb": "click"
      },
      "target": {
        "chain": [
          {
            "by": "roleName",
            "role": "link",
            "name": "Customer Search"
          },
          {
            "by": "structural",
            "note": "link #2 of 16 in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 49,
            "y": 138
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Customer Search"
      }
    },
    {
      "id": "s6",
      "intent": "Enter the requested member ID in the Customer ID search field.",
      "action": {
        "verb": "type",
        "value": {
          "$input": "memberId"
        }
      },
      "target": {
        "chain": [
          {
            "by": "labelProximity",
            "role": "textbox",
            "anchor": "Customer ID"
          },
          {
            "by": "structural",
            "note": "textbox #2 of 3 in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 417,
            "y": 167
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "elementValue": {
          "$self": true
        }
      }
    },
    {
      "id": "s7",
      "intent": "Submit the customer search for member <memberId>.",
      "action": {
        "verb": "click"
      },
      "target": {
        "chain": [
          {
            "by": "roleName",
            "role": "button",
            "name": "Customer Search"
          },
          {
            "by": "structural",
            "note": "button #2 of 2 in main"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 400,
            "y": 323
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "textPresent": "Customer"
      }
    },
    {
      "id": "s8",
      "intent": "Read the savings account balance for member <memberId> from the Balance cell in the accounts frame.",
      "action": {
        "verb": "read",
        "parseAs": "money",
        "saveTo": "balance"
      },
      "target": {
        "chain": [
          {
            "by": "tableCell",
            "column": "Balance",
            "rowContains": "Savings"
          },
          {
            "by": "geometric",
            "lastResort": true,
            "x": 574,
            "y": 34
          }
        ],
        "reasoning": "Recorded from discovery run."
      },
      "risk": "safe",
      "expect": {
        "outputPopulated": "balance"
      }
    }
  ]
}