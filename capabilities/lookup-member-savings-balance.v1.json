{
  "name": "lookup-member-savings-balance",
  "version": "1.0.0",
  "app": { "id": "cascade-cu-console", "startPath": "/login" },

  "inputs": {
    "memberId": { "type": "string", "pattern": "^[0-9]{5}$", "sensitive": false },
    "username": { "type": "string", "sensitive": true },
    "password": { "type": "string", "sensitive": true }
  },

  "outputs": {
    "savingsBalance": { "type": "money", "sensitive": true }
  },

  "businessOutcomes": {
    "MEMBER_NOT_FOUND": { "detect": { "textPresent": "No member matches" } }
  },

  "steps": [
    {
      "id": "s1",
      "intent": "Navigate to the login page",
      "action": { "verb": "navigate", "value": "/login" },
      "target": {
        "chain": [{ "by": "structural", "note": "navigation target" }],
        "reasoning": "Page-level navigation; no element target needed."
      },
      "risk": "safe",
      "expect": { "textPresent": "Sign In" }
    },
    {
      "id": "s2",
      "intent": "Enter the operator username",
      "action": { "verb": "type", "value": { "$input": "username" } },
      "target": {
        "chain": [
          { "by": "labelProximity", "role": "textbox", "anchor": "Username" },
          { "by": "structural", "note": "textbox #1 of 2 in main" }
        ],
        "reasoning": "Username field labeled by adjacent table cell text."
      },
      "risk": "safe",
      "expect": { "elementValue": { "$self": true } }
    },
    {
      "id": "s3",
      "intent": "Enter the operator password",
      "action": { "verb": "type", "value": { "$input": "password" } },
      "target": {
        "chain": [
          { "by": "labelProximity", "role": "textbox", "anchor": "Password" },
          { "by": "structural", "note": "textbox #2 of 2 in main" }
        ],
        "reasoning": "Password field labeled by adjacent table cell text."
      },
      "risk": "safe",
      "expect": { "elementValue": { "$self": true } }
    },
    {
      "id": "s4",
      "intent": "Click Sign In to authenticate",
      "action": { "verb": "click" },
      "target": {
        "chain": [{ "by": "roleName", "role": "button", "name": "Sign In" }],
        "reasoning": "Uniquely named submit button."
      },
      "risk": "safe",
      "expect": { "textPresent": "Dashboard" }
    },
    {
      "id": "s5",
      "intent": "Navigate to member search",
      "action": { "verb": "navigate", "value": "/search" },
      "target": {
        "chain": [{ "by": "structural", "note": "navigation target" }],
        "reasoning": "Page-level navigation."
      },
      "risk": "safe",
      "expect": { "textPresent": "Member Number" }
    },
    {
      "id": "s6",
      "intent": "Enter the member number into the search field",
      "action": { "verb": "type", "value": { "$input": "memberId" } },
      "target": {
        "chain": [
          { "by": "labelProximity", "role": "textbox", "anchor": "Member Number" }
        ],
        "reasoning": "Member number input, labeled by adjacent cell."
      },
      "risk": "safe",
      "expect": { "elementValue": { "$self": true } }
    },
    {
      "id": "s7",
      "intent": "Submit the search",
      "action": { "verb": "click" },
      "target": {
        "chain": [{ "by": "roleName", "role": "button", "name": "Member Search" }],
        "reasoning": "Submit button with tenant-configurable label."
      },
      "risk": "safe",
      "expect": {
        "anyOf": [
          { "textPresent": "Member Details" },
          { "$outcome": "MEMBER_NOT_FOUND" }
        ]
      },
      "onCondition": [
        {
          "if": { "textPresent": "session is about to expire" },
          "do": { "verb": "click", "targetName": "Continue" },
          "maxApplies": 1
        }
      ]
    },
    {
      "id": "s8",
      "intent": "Read the savings account balance from the accounts table",
      "action": { "verb": "read", "parseAs": "money", "saveTo": "savingsBalance" },
      "target": {
        "chain": [
          { "by": "tableCell", "column": "Balance", "rowContains": "Savings" }
        ],
        "reasoning": "Balance cell in the Savings row of the accounts iframe table."
      },
      "risk": "safe",
      "expect": { "outputPopulated": "savingsBalance" }
    }
  ]
}
