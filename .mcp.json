{
  "mcpServers": {
    "computeruse-automation": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "src/mcp/server.ts"],
      "env": {
        "CONSOLE_USER": "${CONSOLE_USER}",
        "CONSOLE_PASS": "${CONSOLE_PASS}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_MODEL": "${OPENAI_MODEL:-gpt-5.6-luna}"
      }
    }
  }
}
