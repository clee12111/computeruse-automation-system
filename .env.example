# ── Required for discovery (LLM-driven exploration) ────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_API_STYLE=responses           # auto-detected from model prefix; force with responses|chat

# ── Target application credentials ─────────────────────────────
# Used as sensitive inputs during discovery and replay.
# Never stored in artifacts. Masked in all evidence journals.
CONSOLE_USER=operator
CONSOLE_PASS=demo123

# ── Optional overrides ─────────────────────────────────────────
# CONSOLE_URL=http://localhost:3000     # base URL override
# CONSOLE_UI_PORT=4000                 # operator console port
# TRUST_STORE_PATH=capabilities/trust.json  # trust store location
# NO_MEMORY=1                          # disable trajectory memory (A/B testing)
# DEBUG_OBSERVE=1                      # log observe() frame errors to stderr

# ── Third-party surface credentials ───────────────────────────
# ParaBank (parabank.parasoft.com) — register at the site for credentials
PARABANK_USER=
PARABANK_PASS=
# Altoro Mutual (demo.testfire.net) — credentials shown on the login page
ALTORO_USER=
ALTORO_PASS=

# ── Test gates (CI skips these by default) ─────────────────────
# RUN_LIVE=1                           # enable live LLM discovery tests
# RUN_PARABANK=1                       # enable ParaBank third-party tests
