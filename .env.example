# ── OpenAI (used by DISCOVERY only — replay never touches an LLM) ──────────
OPENAI_API_KEY=
# Vision + tool-calling capable model. Pin whatever current tier you have access to.
OPENAI_MODEL=gpt-5.6-luna

# ── Mock console operator credentials ──────────────────────────────────────
# Injected at invocation as sensitive inputs (never stored in artifacts;
# masked in all evidence). Defaults match the mock console's seeded accounts.
CONSOLE_USER=operator
CONSOLE_PASS=demo123

# ── Optional overrides ─────────────────────────────────────────────────────
# MOCK_CONSOLE_URL=http://localhost:3000
# SESSION_TTL_MS=600000

# ── Live-run gate (Phase 6) ────────────────────────────────────────────────
# The gated live-discovery test only runs when BOTH are set:
# RUN_LIVE=1
